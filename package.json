{
  "name": "s3amd",
  "version": "1.0.0",
  "description": "Cinema Social 3D Multiplayer",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run install:all && npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "test:multiplayer": "node server/test-multiplayer.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "keywords": [
    "multiplayer",
    "threejs",
    "cinema",
    "spatial-audio",
    "livekit",
    "webrtc"
  ],
  "author": "perdidoguru",
  "license": "MIT"
}
